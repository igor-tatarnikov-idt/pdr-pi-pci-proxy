{
  "Urls": "http://127.0.0.1:5700",
  "Tokenizer": { "BaseUrl": "http://tokenizer.localhost:5100" },
  "Providers": { "encrypted-provider": { "Hook": "encrypt", "TrustedCertificate": "../../certs/sandbox.crt" } },
  "ReverseProxy": {
    "Routes": {
      "will-call": {
        "ClusterId": "will-call",
        "Match": { "Path": "/will-call/{**path}" },
        "Transforms": [
          { "PathRemovePrefix": "/will-call" },
          { "X-Forwarded": "Append", "Prefix": "Off" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/will-call" },
          { "RequestHeaderRemove": "Accept-Encoding" },
          { "RequestHeaderRemove": "Range" },
          { "RequestHeaderRemove": "If-Range" },
          { "RequestHeader": "Via", "Append": "1.1 pci-proxy" }
        ]
      }
    },
    "Clusters": {
      "will-call": { "Destinations": { "adapter": { "Address": "http://will-call-adapter.localhost:5800" } } }
    }
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "System.Net.Http.HttpClient": "Warning" },
    "Console": { "FormatterName": "sandbox" }
  }
}
